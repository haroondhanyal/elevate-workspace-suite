<odoo>
    <record id="view_elevate_erp_dashboard_form" model="ir.ui.view">
        <field name="name">elevate.erp.dashboard.form</field><field name="model">elevate.erp.dashboard</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1><p class="text-muted">Live operational overview for the selected company.</p></div><group><field name="company_id" readonly="1"/></group><group col="5"><group string="Branches"><field name="branch_count" readonly="1"/></group><group string="Departments"><field name="department_count" readonly="1"/></group><group string="Warehouses"><field name="warehouse_count" readonly="1"/></group><group string="Pending approvals"><field name="pending_approval_count" readonly="1"/></group><group string="Approved requests"><field name="approved_this_month_count" readonly="1"/></group></group></sheet></form></field>
    </record>
    <record id="action_elevate_erp_dashboard" model="ir.actions.act_window"><field name="name">Operations Dashboard</field><field name="res_model">elevate.erp.dashboard</field><field name="res_id" ref="dashboard_elevate_erp"/><field name="view_mode">form</field><field name="target">current</field></record>
</odoo>
