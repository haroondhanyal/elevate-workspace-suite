<odoo>
    <record id="module_category_elevate_erp" model="ir.module.category"><field name="name">Elevate ERP</field><field name="sequence">30</field></record>
    <record id="privilege_elevate_erp" model="res.groups.privilege"><field name="name">Elevate ERP</field><field name="category_id" ref="module_category_elevate_erp"/><field name="sequence">30</field></record>
    <record id="group_erp_user" model="res.groups"><field name="name">ERP User</field><field name="privilege_id" ref="privilege_elevate_erp"/></record>
    <record id="group_erp_manager" model="res.groups"><field name="name">ERP Manager</field><field name="privilege_id" ref="privilege_elevate_erp"/><field name="implied_ids" eval="[(4, ref('group_erp_user'))]"/></record>
    <record id="group_erp_approval_manager" model="res.groups"><field name="name">Approval Manager</field><field name="privilege_id" ref="privilege_elevate_erp"/><field name="implied_ids" eval="[(4, ref('group_erp_manager'))]"/></record>
    <record id="branch_company_rule" model="ir.rule"><field name="name">ERP branch multi-company rule</field><field name="model_id" ref="model_elevate_erp_branch"/><field name="global" eval="True"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="approval_company_rule" model="ir.rule"><field name="name">ERP approval multi-company rule</field><field name="model_id" ref="model_elevate_erp_approval_request"/><field name="global" eval="True"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="department_company_rule" model="ir.rule"><field name="name">ERP department multi-company rule</field><field name="model_id" ref="model_elevate_erp_department"/><field name="global" eval="True"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="approval_policy_company_rule" model="ir.rule"><field name="name">ERP approval policy multi-company rule</field><field name="model_id" ref="model_elevate_erp_approval_policy"/><field name="global" eval="True"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
